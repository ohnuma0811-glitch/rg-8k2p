{
  "rules": {
    "secret": {
      ".read": "auth != null && auth.uid === 'GM_UID_HERE'",
      ".write": "auth != null && auth.uid === 'GM_UID_HERE'",
      ".validate": "newData.hasChildren(['code', 'codeId', 'active'])",
      "code": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
      "codeId": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
      "active": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },
    "status": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'GM_UID_HERE'",
      ".validate": "newData.hasChildren(['codeId', 'active'])",
      "codeId": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
      "active": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },
    "attempts": {
      ".read": "auth != null && auth.uid === 'GM_UID_HERE'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && newData.exists()) || (auth.uid === 'GM_UID_HERE' && !newData.exists()))",
        ".validate": "newData.hasChildren(['codeId', 'count', 'guess', 'device', 'at']) && newData.child('codeId').val() === root.child('secret/codeId').val() && newData.child('count').val() <= 5 && ((data.exists() && data.child('codeId').val() === newData.child('codeId').val()) ? newData.child('count').val() === data.child('count').val() + 1 : newData.child('count').val() === 1)",
        "codeId": { ".validate": "newData.isString()" },
        "count": { ".validate": "newData.isNumber()" },
        "guess": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
        "device": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "access": {
      ".read": "auth != null && auth.uid === 'GM_UID_HERE'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['codeId', 'name', 'at']) && root.child('secret/active').val() === true && newData.child('codeId').val() === root.child('secret/codeId').val() && root.child('attempts/' + $uid + '/codeId').val() === root.child('secret/codeId').val() && root.child('attempts/' + $uid + '/guess').val() === root.child('secret/code').val()",
        "codeId": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{0,12}$/)" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "playtime": {
      ".read": true,
      "$name": {
        ".validate": "$name.matches(/^[A-Z]{1,12}$/)",
        "$day": {
          ".write": "auth != null && auth.uid === 'GM_UID_HERE'",
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $uid !== 'reset' && root.child('access/' + auth.uid).exists()",
            ".validate": "newData.isNumber() && (($uid === 'reset' && auth.uid === 'GM_UID_HERE') || ($uid !== 'reset' && newData.val() >= 0 && newData.val() <= 86400 && newData.val() >= (data.exists() ? data.val() : 0)))"
          }
        }
      }
    },
    "limits": {
      ".read": true,
      "$name": {
        ".write": "auth != null && auth.uid === 'GM_UID_HERE'",
        ".validate": "$name.matches(/^[A-Z]{1,12}$/) && newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
      }
    }
  }
}
